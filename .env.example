# Copia este archivo como .env. El archivo .env nunca se sube a GitHub.

PORT=3000

# Local: mongodb://127.0.0.1:27017/gestion_productos (con npm run db)
# Nube: la cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/gestion_productos

# Secreto para firmar los JWT. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=2h

# Usuario de ejemplo que crea npm run seed
SEED_EMAIL=admin@inventario.test
SEED_PASSWORD=cambia_esta_contrasena
